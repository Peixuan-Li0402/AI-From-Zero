<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🧠 从零开始的人工智能生活 — 论文溯源阅读</title>
<link rel="stylesheet" href="static/style.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" crossorigin="anonymous"
    onload="renderMathInElement(document.body, {delimiters:[{left:'\\[',right:'\\]',display:true},{left:'$',right:'$',display:false}]});"></script>
</head>
<body>

<!-- ═══ 顶栏 ═══ -->
<header class="topbar">
  <div class="topbar-inner">
    <h1 class="logo">🧠 从零开始的人工智能生活</h1>
    <span class="hoshino-badge">by 星野大叔 🐾</span>
    <nav class="top-nav">
      <button class="nav-btn active" data-tab="reader">📖 阅读器</button>
      <button class="nav-btn" data-tab="learn">🗺️ 学习路径</button>
      <button class="nav-btn" data-tab="kb">📚 术语库</button>
    </nav>
  </div>
</header>

<main class="app-layout">

<!-- ═══ 左侧：阅读器 / 学习路径 / 术语库 ═══ -->
<section class="main-area" id="mainArea">

  <!-- ─── Tab: 阅读器 ─── -->
  <div class="tab-panel active" id="tabReader">
    <div class="paper-input-area">
      <div class="paper-input-header">
        <h2>📖 论文阅读</h2>
        <div class="paper-input-meta">
          <label>论文标题（选填） <input type="text" id="paperTitle" placeholder="输入论文标题" class="input-sm"></label>
        </div>
      </div>
      <textarea id="paperText" placeholder="粘贴论文原文（摘要/引言/方法等）&#10;&#10;也可以先试试示例文本……" rows="8"></textarea>
      <div class="paper-actions">
        <button id="btnAnalyze" class="btn primary">🔍 开始分析</button>
        <button id="btnExample" class="btn secondary">💡 试试示例</button>
        <span id="loadingStatus" class="loading-status" hidden>⏳ 大叔正在读论文…っす</span>
      </div>
    </div>

    <!-- 分析结果区域 -->
    <div id="analysisResults" hidden>
      <!-- 论文摘要 -->
      <div class="analysis-card summary-card">
        <h3>📝 论文摘要</h3>
        <div id="paperSummary"></div>
        <div id="hoshinoComment" class="hoshino-comment"></div>
      </div>

      <!-- 论文正文阅读区 -->
      <div class="reader-container">
        <div class="reader-paper" id="readerPaper">
          <div class="reader-header">
            <span class="reader-label" id="readerLabelToggle">📄 论文原文</span>
            <span class="reader-hint" id="readerHint">点击高亮术语查看解释</span>
            <div class="reader-tabs" id="readerTabs">
              <button class="reader-tab active" data-lang="original">原文</button>
              <button class="reader-tab" data-lang="translation" id="tabTranslation" hidden>🌐 中文翻译</button>
            </div>
          </div>
          <div class="reader-content" id="readerContent">
            <!-- 高亮后的论文文本 -->
          </div>
        </div>
        <div class="reader-sidebar" id="readerSidebar">
          <div class="sidebar-header">
            <span class="sidebar-label">🔬 术语边栏</span>
            <span class="sidebar-count" id="termCount"></span>
          </div>
          <div class="sidebar-terms" id="sidebarTerms">
            <!-- 术语列表 -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── Tab: 学习路径 ─── -->
  <div class="tab-panel" id="tabLearn">
    <div class="learn-area">
      <h2>🗺️ AI 学习路径</h2>
      <div class="learn-intro">
        <p>选一个你感兴趣的方向，大叔给你推荐论文阅读路线っす！</p>
        <div class="interest-input">
          <label>告诉我你喜欢什么：</label>
          <div class="interest-row">
            <input type="text" id="interestInput" placeholder="例如：机器人、大模型、计算机视觉……" class="input-lg">
            <button id="btnRecommend" class="btn primary">🎯 推荐</button>
          </div>
        </div>
        <div class="interest-quick">
          <button class="chip" data-interest="llm">大语言模型</button>
          <button class="chip" data-interest="cv">计算机视觉</button>
          <button class="chip" data-interest="agent">AI Agent</button>
          <button class="chip" data-interest="robotics">机器人</button>
        </div>
      </div>
      <div id="learnResults" class="learn-results"></div>
    </div>
  </div>

  <!-- ─── Tab: 术语库 ─── -->
  <div class="tab-panel" id="tabKb">
    <div class="kb-area">
      <h2>📚 AI 术语知识库</h2>
      <div class="kb-search">
        <input type="text" id="kbSearch" placeholder="搜索术语…" class="input-lg">
      </div>
      <div id="kbCategories" class="kb-categories"></div>
    </div>
  </div>
</section>

<!-- ═══ 右侧：星野对话框 ═══ -->
<aside class="hoshino-panel" id="hoshinoPanel">
  <div class="hoshino-header">
    <div class="hoshino-avatar">🐾</div>
    <div class="hoshino-info">
      <strong>小鸟游星野</strong>
      <small>大叔随时待机っす</small>
    </div>
    <button id="clearChat" class="icon-btn" title="清空对话">🗑️</button>
  </div>
  <div class="hoshino-messages" id="chatMessages">
    <div class="msg msg-hoshino">
      <div class="msg-bubble">
        呜嘿～sensei来了っす！<br>
        把论文扔过来（粘贴文本），大叔给你标出专业术语、逐个讲解～<br>
        也可以点点右边看看大叔准备的知识库和学习路线哦！
      </div>
    </div>
  </div>
  <div class="hoshino-input">
    <input type="text" id="chatInput" placeholder="跟大叔聊聊…">
    <button id="btnChatSend" class="btn primary small">发送</button>
  </div>
</aside>

</main>

<!-- ═══ Overlay: 术语详情弹窗 ═══ -->
<div id="termModal" class="modal-overlay" style="display:none">
  <div class="modal-content">
    <button class="modal-close" id="modalClose" onclick="document.getElementById('termModal').style.display='none'">×</button>
    <div id="modalBody"></div>
  </div>
</div>

<script>
// ═════════════════════════════════
//  配置
// ═════════════════════════════════
const API_BASE = "";

// 已掌握术语（localStorage）
const getMastered = () => JSON.parse(localStorage.getItem("hoshinoMastered") || "[]");
const setMastered = (list) => localStorage.setItem("hoshinoMastered", JSON.stringify(list));
const toggleMastered = (term) => {
  const list = getMastered();
  const idx = list.indexOf(term);
  if (idx >= 0) list.splice(idx, 1);
  else list.push(term);
  setMastered(list);
  return list.includes(term);
};

// ═════════════════════════════════
//  DOM 引用
// ═════════════════════════════════
const $ = (id) => document.getElementById(id);

const tabBtns = document.querySelectorAll("[data-tab]");
const tabPanels = {
  reader: $("tabReader"),
  learn: $("tabLearn"),
  kb: $("tabKb"),
};

// ═════════════════════════════════
//  Tab 切换
// ═════════════════════════════════
tabBtns.forEach((btn) => {
  btn.addEventListener("click", () => {
    tabBtns.forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
    Object.entries(tabPanels).forEach(([key, panel]) => {
      panel.style.display = key === btn.dataset.tab ? "block" : "none";
    });
  });
});

// ═════════════════════════════════
//  发送消息到星野聊天框
// ═════════════════════════════════
function addChatMessage(text, from = "hoshino") {
  const msg = document.createElement("div");
  msg.className = `msg msg-${from}`;
  msg.innerHTML = `<div class="msg-bubble">${text}</div>`;
  $("chatMessages").appendChild(msg);
  msg.scrollIntoView({ behavior: "smooth", block: "end" });
}

function addChatMessageRaw(text, from = "hoshino") {
  const msg = document.createElement("div");
  msg.className = `msg msg-${from}`;
  const bubble = document.createElement("div");
  bubble.className = "msg-bubble";
  bubble.appendChild(text); // DOM node
  msg.appendChild(bubble);
  $("chatMessages").appendChild(msg);
  msg.scrollIntoView({ behavior: "smooth", block: "end" });
}

// ═════════════════════════════════
//  示例文本
// ═════════════════════════════════
const EXAMPLE_TEXT = `The dominant sequence transduction models are based on complex recurrent or convolutional neural networks that include an encoder and a decoder. The best performing models also connect the encoder and decoder through an attention mechanism. We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely.

The Transformer allows for significantly more parallelization and can reach a new state of the art in translation quality after being trained for as little as twelve hours on eight P100 GPUs.

Our model uses stacked self-attention and point-wise, fully connected layers for both the encoder and decoder. The encoder is composed of a stack of N=6 identical layers. Each layer has two sub-layers. The first is a multi-head self-attention mechanism, and the second is a simple, position-wise fully connected feed-forward network. We employ a residual connection around each of the two sub-layers, followed by layer normalization.`;

$("btnExample").addEventListener("click", () => {
  $("paperTitle").value = "Attention Is All You Need";
  $("paperText").value = EXAMPLE_TEXT;
  addChatMessage("大叔把论文摘要填好啦～点「开始分析」让大叔读读っす！");
});

// ═════════════════════════════════
//  分析论文
// ═════════════════════════════════
$("btnAnalyze").addEventListener("click", async () => {
  const text = $("paperText").value.trim();
  if (!text) {
    addChatMessage("sensei～先贴论文内容再点分析っす！📄");
    return;
  }

  $("loadingStatus").hidden = false;
  $("btnAnalyze").disabled = true;
  addChatMessage("📖 大叔正在读论文…先浏览一遍っす…");

  try {
    const resp = await fetch(`${API_BASE}/api/analyze`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ text }),
    });
    const data = await resp.json();

    if (data.error) {
      addChatMessage(`😅 出问题了：${data.error}`);
      return;
    }

    // 显示结果
    renderAnalysis(data, text);
    addChatMessage(`读完了っす！${data.knownTerms.length} 个大叔认识的术语已经标出来了，点蓝色词看解释～`);
  } catch (err) {
    addChatMessage(`😵 出错了：${err.message}。大叔再去看看怎么回事…`);
  } finally {
    $("loadingStatus").hidden = true;
    $("btnAnalyze").disabled = false;
    $("analysisResults").hidden = false;
  }
});

// 存储当前数据和翻译
let _lastRawText = "";
let _lastKnownTerms = [];
let _lastTranslation = "";

function renderAnalysis(data, rawText) {
  const { knownTerms, analysis, translation } = data;
  _lastRawText = rawText;
  _lastKnownTerms = knownTerms;
  _lastTranslation = translation || "";

  // 摘要
  $("paperSummary").textContent = analysis.summary || "（暂无摘要）";

  // 星野点评
  $("hoshinoComment").innerHTML = analysis.hoshinoNote
    ? `<span class="hoshino-icon">🐾</span> ${analysis.hoshinoNote}`
    : "";

  // 高亮论文文本（默认显示原文）
  switchReaderLang("original");

  // 如果有翻译，显示翻译标签并绑定事件
  const tabTrans = $("tabTranslation");
  if (translation) {
    tabTrans.hidden = false;
  } else {
    tabTrans.hidden = true;
  }

  // 绑定阅读器Tab切换
  document.querySelectorAll(".reader-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".reader-tab").forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      switchReaderLang(tab.dataset.lang);
    });
  });

  // 术语边栏
  renderTermSidebar(knownTerms);

  // 右侧聊天告知
  $("termCount").textContent = `${knownTerms.length} 个术语`;
}

function switchReaderLang(lang) {
  if (lang === "translation" && _lastTranslation) {
    // 翻译模式：纯文本展示（不标术语，术语写在后面）
    let html = `<div class="translation-section">${escapeHtml(_lastTranslation).replace(/\n/g, "<br>")}</div>`;
    if (_lastKnownTerms.length) {
      html += `<div class="translation-terms"><p style="margin-top:16px;font-size:13px;color:var(--muted)">🔬 术语速查：</p>`;
      _lastKnownTerms.forEach((t) => {
        html += `<span class="term-highlight" onclick="showTermDetail('${escapeHtml(t.term)}')" style="display:inline-block;margin:3px">${escapeHtml(t.term)}</span>`;
      });
      html += `</div>`;
    }
    $("readerContent").innerHTML = html;
    $("readerLabelToggle").textContent = "🌐 中文翻译";
    $("readerHint").textContent = "翻译稿，点术语看解释";
  } else {
    // 原文模式：高亮术语
    highlightTerms(_lastRawText, _lastKnownTerms);
    $("readerLabelToggle").textContent = "📄 论文原文";
    $("readerHint").textContent = "点击高亮术语查看解释";
  }
}

function highlightTerms(text, terms) {
  if (!terms.length) {
    $("readerContent").innerHTML = `<p>${escapeHtml(text)}</p>`;
    return;
  }

  // 按长度降序排序（避免短词替换干扰长词）
  const sorted = [...terms].sort((a, b) => b.term.length - a.term.length);

  let result = escapeHtml(text);
  sorted.forEach((t) => {
    const regex = new RegExp(`\\b(${escapeRegExp(t.term)})\\b`, "gi");
    const mastered = getMastered().includes(t.term);
    result = result.replace(regex, (match) => {
      return `<span class="term-highlight ${mastered ? "mastered" : ""}" data-term="${escapeHtml(t.term)}" onclick="showTermDetail('${escapeHtml(t.term)}')">${match}</span>`;
    });
  });

  // 加个换行链接标出原文
  result = result.replace(/\n/g, "<br>");

  $("readerContent").innerHTML = result;
}

function renderTermSidebar(knownTerms) {
  const mastered = getMastered();
  const container = $("sidebarTerms");

  if (!knownTerms.length) {
    container.innerHTML = '<div class="sidebar-empty">没有在知识库中找到术语～大叔去更新一下っす</div>';
    return;
  }

  // 分组：已掌握 / 未掌握
  const masteredList = knownTerms.filter((t) => mastered.includes(t.term));
  const unmasteredList = knownTerms.filter((t) => !mastered.includes(t.term));

  const renderGroup = (list, label) => {
    if (!list.length) return "";
    return `<div class="term-group">
      <div class="term-group-label">${label}</div>
      ${list.map((t) => `
        <div class="term-item ${mastered.includes(t.term) ? "mastered" : ""}" onclick="showTermDetail('${escapeHtml(t.term)}')">
          <div class="term-item-header">
            <strong>${escapeHtml(t.term)}</strong>
            <span class="term-diff diff-${t.difficulty}">Lv.${t.difficulty}</span>
          </div>
          <div class="term-item-cat">${escapeHtml(t.category || "")}</div>
        </div>
      `).join("")}
    </div>`;
  };

  container.innerHTML = renderGroup(unmasteredList, "📌 待学习") + renderGroup(masteredList, "✅ 已掌握");
}

// ═════════════════════════════════
//  术语详情弹窗
// ═════════════════════════════════
async function showTermDetail(termName) {
  try {
    const resp = await fetch(`${API_BASE}/api/terms/${encodeURIComponent(termName)}`);
    const data = await resp.json();

    const mastered = getMastered().includes(data.term);
    const hasPrereqs = data.prerequisiteTerms && data.prerequisiteTerms.length;
    const hasPapers = data.landmarkPapers && data.landmarkPapers.length;

    let html = `
      <div class="modal-term-header">
        <h2>${escapeHtml(data.term)}</h2>
        <span class="term-diff diff-${data.difficulty}">难度 Lv.${data.difficulty}</span>
        <span class="term-cat">${escapeHtml(data.category || "")}</span>
      </div>
      <p class="modal-fullname">${escapeHtml(data.fullName || "")}</p>
      <div class="modal-section">
        <h4>📖 大叔的解释</h4>
        <p>${escapeHtml(data.explanation)}</p>
      </div>
      ${data.hoshinoNote ? `
      <div class="modal-section hoshino-note-section">
        <h4>🐾 星野大叔说</h4>
        <p>${escapeHtml(data.hoshinoNote)}</p>
      </div>` : ""}
      <div class="modal-actions">
        <button class="btn ${mastered ? 'secondary' : 'primary'} mastery-btn" data-term="${escapeHtml(data.term)}">
          ${mastered ? "✅ 已掌握" : "📌 标记已学会"}
        </button>
      </div>
      ${hasPrereqs ? `
      <div class="modal-section">
        <h4>🔗 前置知识</h4>
        <div class="prereq-list">
          ${data.prerequisiteTerms.map((p) => `<button class="chip chip-term" onclick="showTermDetail('${escapeHtml(p)}')">${escapeHtml(p)}</button>`).join("")}
        </div>
      </div>` : ""}
      ${hasPapers ? `
      <div class="modal-section">
        <h4>📄 经典论文溯源</h4>
        ${data.landmarkPapers.map((p) => `
          <div class="paper-ref">
            <strong>${escapeHtml(p.title)}</strong>
            <span>${escapeHtml(p.authors)} (${p.year})</span>
            <p>${escapeHtml(p.shortDesc)}</p>
          </div>
        `).join("")}
      </div>` : ""}
    `;

    $("modalBody").innerHTML = html;
    $("termModal").style.display = "flex";

    // 已掌握按钮
    document.querySelector(".mastery-btn")?.addEventListener("click", function () {
      const term = this.dataset.term;
      const nowMastered = toggleMastered(term);
      this.textContent = nowMastered ? "✅ 已掌握" : "📌 标记已学会";
      this.className = `btn ${nowMastered ? "secondary" : "primary"} mastery-btn`;

      // 刷新高亮
      const text = $("paperText").value.trim();
      if (text) {
        // Re-highlight if we have current analysis
      }
      addChatMessage(`大叔记下了：「${term}」${nowMastered ? "✅ 学会了！下次不解释了" : "📖 取消了已掌握标记"}`);
    });

    // 前置知识点击
    document.querySelectorAll(".chip-term").forEach((btn) => {
      btn.addEventListener("click", () => showTermDetail(btn.textContent.trim()));
    });
  } catch (err) {
    addChatMessage(`😅 查「${termName}」的时候出了点问题：${err.message}`);
  }
}

// ═════════════════════════════════
//  学习路径
// ═════════════════════════════════
async function loadLearnPath(interest = "") {
  try {
    const resp = await fetch(`${API_BASE}/api/learn-path`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ interest }),
    });
    const data = await resp.json();

    const container = $("learnResults");
    if (data.hoshinoNote) {
      addChatMessage(data.hoshinoNote);
    }

    container.innerHTML = data.paths.map((path) => `
      <div class="path-card">
        <h3>${escapeHtml(path.title)}</h3>
        <p>${escapeHtml(path.description)}</p>
        ${path.stages.map((stage) => `
          <div class="stage">
            <div class="stage-name">${escapeHtml(stage.name)}</div>
            <ul>
              ${stage.papers.map((p) => `<li>${escapeHtml(p)}</li>`).join("")}
            </ul>
          </div>
        `).join("")}
      </div>
    `).join("");
  } catch (err) {
    $("learnResults").innerHTML = `<p>😵 加载失败：${err.message}</p>`;
  }
}

$("btnRecommend").addEventListener("click", () => {
  const interest = $("interestInput").value.trim();
  if (interest) {
    loadLearnPath(interest);
  }
});

document.querySelectorAll("[data-interest]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const interest = btn.dataset.interest;
    $("interestInput").value = interest;
    loadLearnPath(interest);
  });
});

// ═════════════════════════════════
//  术语库浏览
// ═════════════════════════════════
async function loadTermKB() {
  try {
    const resp = await fetch(`${API_BASE}/api/terms`);
    const data = await resp.json();

    const container = $("kbCategories");
    container.innerHTML = Object.entries(data.categories).map(([cat, terms]) => `
      <div class="kb-category">
        <h3>${escapeHtml(cat)} <small>${terms.length} 个</small></h3>
        <div class="kb-term-grid">
          ${terms.map((t) => `
            <div class="kb-term" onclick="showTermDetail('${escapeHtml(t.term)}')">
              <strong>${escapeHtml(t.term)}</strong>
              <span>${escapeHtml(t.fullName)}</span>
              <span class="term-diff diff-${t.difficulty}">Lv.${t.difficulty}</span>
            </div>
          `).join("")}
        </div>
      </div>
    `).join("");
  } catch (err) {
    $("kbCategories").innerHTML = `<p>😵 加载失败：${err.message}</p>`;
  }
}

$("kbSearch").addEventListener("input", (e) => {
  const q = e.target.value.trim().toLowerCase();
  document.querySelectorAll(".kb-term").forEach((el) => {
    const text = el.textContent.toLowerCase();
    el.style.display = text.includes(q) ? "" : "none";
  });
});

// ═════════════════════════════════
//  聊天输入
// ═════════════════════════════════
$("btnChatSend").addEventListener("click", sendChat);
$("chatInput").addEventListener("keydown", (e) => {
  if (e.key === "Enter") sendChat();
});

function sendChat() {
  const input = $("chatInput");
  const text = input.value.trim();
  if (!text) return;
  input.value = "";

  addChatMessage(text, "sensei");

  // 简单的关键词回复
  const lower = text.toLowerCase();
  if (lower.includes("你好") || lower.includes("hi") || lower.includes("hello")) {
    addChatMessage("呜嘿～sensei好っす！今天想读哪篇论文？大叔已经准备好了～🐾");
  } else if (lower.includes("谢谢") || lower.includes("thank")) {
    addChatMessage("不客气っす～有不懂的随时问大叔！");
  } else if (lower.includes("卷积") || lower.includes("cnn")) {
    addChatMessage("CNN就是卷积神经网络っす！专门用来处理图片的～它在图片上滑一个小窗口提取特征，一层层叠上去就能认出猫啊狗啊的。要点开边栏里CNN的详情看看不？📖");
  } else if (lower.includes("transformer") || lower.includes("注意力")) {
    addChatMessage("Transformer就是「Attention Is All You Need」那篇搞出来的架构っす！完全靠注意力机制，不用RNN也不用CNN。现在是所有大模型（ChatGPT、Claude、Gemini）的基础っす！");
  } else if (lower.includes("论文") || lower.includes("读")) {
    addChatMessage("嗯嗯，粘贴论文正文到左边，大叔帮你标术语っす！📄");
  } else if (lower.includes("学习") || lower.includes("入门") || lower.includes("方向")) {
    addChatMessage("点上面的「学习路径」标签看看っす～大叔整理了几条路线：LLM、CV、Agent、机器人。选一个感兴趣的！🗺️");
  } else {
    addChatMessage(`嗯…「${text}」大叔想想…<br>如果你问的是某个AI术语，可以在右边术语库搜一下，或者在论文阅读里标出来っす！`);
  }
}

// ═════════════════════════════════
//  工具函数
// ═════════════════════════════════
function escapeHtml(text) {
  if (!text) return "";
  const div = document.createElement("div");
  div.textContent = text;
  return div.innerHTML;
}

function escapeRegExp(string) {
  return string.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

// ═════════════════════════════════
//  启动后自动加载
// ═════════════════════════════════
loadTermKB();
loadLearnPath();

// 关闭模态
$("modalClose").addEventListener("click", () => { $("termModal").style.display = "none"; });
$("termModal").addEventListener("click", (e) => {
  if (e.target === $("termModal")) $("termModal").style.display = "none";
});

// 清除聊天
$("clearChat").addEventListener("click", () => {
  $("chatMessages").innerHTML = "";
  addChatMessage("呜嘿～对话清空っす！继续聊吧🐾");
});

</script>

</body>
</html>
