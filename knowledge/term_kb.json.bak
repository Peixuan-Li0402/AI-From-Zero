        }
      ],
      "relatedTerms": [
        "RLHF",
        "PPO",
        "GRPO",
        "对齐"
      ]
    },
    {
      "term": "GRPO",
      "fullName": "组相对策略优化",
      "category": "训练范式",
      "difficulty": 4,
      "aliases": [
