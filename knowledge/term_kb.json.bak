{
  "version": "1.2",
  "lastUpdated": "2026-05-28",
  "terms": [
    {
      "term": "MLP",
      "fullName": "多层感知机",
      "category": "基础模型",
      "difficulty": 1,
      "aliases": [
        "多层感知器",
        "全连接网络",
        "多层感知机",
        "multilayer perceptron",
        "multi-layer perceptron"
      ],
      "explanation": "最简单的神经网络结构。由输入层、若干隐藏层和输出层组成，每层神经元之间全连接。可以理解为用数学函数逼近任意复杂映射的「万能近似器」。",
      "hoshinoNote": "就…神经网络最基础的积木块っす。把一堆线性变换叠起来扔进非线性激活函数，能拟合任何函数。",
      "prerequisiteTerms": [
        "神经元",
        "激活函数"
      ],
      "landmarkPapers": [
        {
          "title": "Learning representations by back-propagating errors",
          "authors": "Rumelhart et al.",
          "year": 1986,
          "shortDesc": "反向传播算法的奠基之作，MLP的训练基础"
        }
      ],
      "relatedTerms": [
        "激活函数",
        "反向传播",
        "深度学习"
      ]
    },
    {
      "term": "CNN",
      "fullName": "卷积神经网络",
      "category": "基础模型",
      "difficulty": 2,
      "aliases": [
        "卷积网络",
        "ConvNet",
        "卷积神经网络",
        "convolutional neural network",
        "convolutional neural networks"
      ],
      "explanation": "专门处理网格状数据（如图像）的神经网络。通过卷积核在输入上滑动提取局部特征，参数共享大大减少了参数量。核心操作：卷积 → 激活 → 池化。",
      "hoshinoNote": "就是给图像做「放大镜扫描」っす。一个小窗口在图片上扫来扫去，提取边缘→纹理→形状→最终认出是什么东西。",
      "prerequisiteTerms": [
        "MLP",
        "激活函数",
        "反向传播"
      ],
      "landmarkPapers": [
        {
          "title": "ImageNet Classification with Deep Convolutional Neural Networks (AlexNet)",
          "authors": "Krizhevsky et al.",
          "year": 2012,
          "shortDesc": "CNN在图像分类上的突破性工作，开启了深度学习时代"
        },
        {
          "title": "Very Deep Convolutional Networks for Large-Scale Image Recognition (VGG)",
          "authors": "Simonyan & Zisserman",
          "year": 2014,
          "shortDesc": "证明网络深度对性能的重要性"
        },
        {
          "title": "Deep Residual Learning for Image Recognition (ResNet)",
          "authors": "He et al.",
          "year": 2015,
          "shortDesc": "引入残差连接解决深层网络退化问题"
        }
      ],
      "relatedTerms": [
        "池化",
        "残差连接",
        "图像分类",
        "目标检测"
      ]
    },
    {
      "term": "RNN",
      "fullName": "循环神经网络",
      "category": "基础模型",
      "difficulty": 2,
      "aliases": [
        "递归神经网络",
        "循环神经网络",
        "recurrent neural network",
        "recurrent neural networks"
      ],
      "explanation": "处理序列数据（文本、时间序列等）的神经网络。核心思想是隐藏状态在时间步之间传递，网络有「记忆」能力。缺点是长序列时梯度消失/爆炸。",
      "hoshinoNote": "有点像大叔记日记——昨天的内容影响今天，今天的内容影响明天。但记太久远的事情就会忘掉前面说的啥（梯度消失っす）。",
      "prerequisiteTerms": [
        "MLP",
        "反向传播"
      ],
      "landmarkPapers": [
        {
          "title": "Long Short-Term Memory (LSTM)",
          "authors": "Hochreiter & Schmidhuber",
          "year": 1997,
          "shortDesc": "解决RNN长程依赖的门控机制"
        }
      ],
      "relatedTerms": [
        "LSTM",
        "门控循环单元",
        "序列建模",
        "梯度消失"
      ]
    },
    {
      "term": "LSTM",
      "fullName": "长短期记忆网络",
      "category": "基础模型",
      "difficulty": 2,
      "aliases": [
        "长短时记忆",
        "long short-term memory"
      ],
      "explanation": "RNN的改进版，通过引入遗忘门、输入门、输出门来控制信息的记忆与遗忘。可以看作是RNN加了一个「智能笔记本」，决定记住什么、忘掉什么。",
      "hoshinoNote": "大叔的记性不好的时候……LSTM就是给RNN装了个备忘录っす。能决定「这个要记住」「那个可以忘掉」。",
      "prerequisiteTerms": [
        "RNN"
      ],
      "landmarkPapers": [
        {
          "title": "Long Short-Term Memory",
          "authors": "Hochreiter & Schmidhuber",
          "year": 1997,
          "shortDesc": "LSTM原始论文"
        }
      ],
      "relatedTerms": [
        "RNN",
        "GRU",
        "门控机制"
      ]
    },
    {
      "term": "Attention",
      "fullName": "注意力机制",
      "category": "核心概念",
      "difficulty": 3,
      "aliases": [
        "注意力",
        "attention mechanism"
      ],
      "explanation": "一种让模型「关注重要部分」的机制。对于输入序列的每个位置，Attention计算它对其他位置的「关注权重」并加权聚合信息。最早用于机器翻译，后成为Transformer的核心。",
      "hoshinoNote": "就像大叔读论文——标题扫一眼，重点看摘要和方法部分，其他地方随便翻翻。Attention就是让模型学会「该看哪里」っす。",
      "prerequisiteTerms": [
        "Seq2Seq",
        "编码器-解码器"
      ],
      "landmarkPapers": [
        {
          "title": "Neural Machine Translation by Jointly Learning to Align and Translate (Bahdanau Attention)",
          "authors": "Bahdanau et al.",
          "year": 2014,
          "shortDesc": "注意力机制首次被引入NMT"
        }
      ],
      "relatedTerms": [
        "Self-Attention",
        "Transformer",
        "多头注意力",
        "Seq2Seq"
      ]
    },
    {
      "term": "Self-Attention",
      "fullName": "自注意力",
      "category": "核心概念",
      "difficulty": 3,
      "aliases": [
        "自注意力机制",
        "self attention"
      ],
      "explanation": "Attention的一种特例，序列中的每个位置对序列中所有位置（包括自己）计算注意力权重。让模型理解一个句子中词与词之间的关系，无论距离多远。",
      "hoshinoNote": "Self就是「自己看自己」っす。一个句子里的每个词都看看其他词，看懂谁跟谁有关系——比如「他」指的是「小明」。",
      "prerequisiteTerms": [
        "Attention"
      ],
      "landmarkPapers": [
        {
          "title": "Attention Is All You Need",
          "authors": "Vaswani et al.",
          "year": 2017,
          "shortDesc": "Transformer的诞生之作，提出了Self-Attention和Multi-Head Attention"
        }
      ],
      "relatedTerms": [
        "Transformer",
        "多头注意力",
        "位置编码"
      ]
    },
    {
      "term": "Transformer",
      "fullName": "Transformer模型",
      "category": "基础架构",
      "difficulty": 3,
      "aliases": [
        "变换器"
      ],
      "explanation": "完全基于Self-Attention的模型架构，抛弃了RNN/CNN。由编码器和解码器堆叠而成，每层包含多头自注意力和前馈网络。并行计算能力强，训练速度快。几乎所有现代大语言模型的基础架构。",
      "hoshinoNote": "就是Attention Is All You Need那篇论文搞出来的东西っす。现在ChatGPT、Gemini、Claude全都是Transformer变体，可以说是AI界的「电」了。",
      "prerequisiteTerms": [
        "Self-Attention",
        "多头注意力",
        "位置编码",
        "LayerNorm"
      ],
      "landmarkPapers": [
        {
          "title": "Attention Is All You Need",
          "authors": "Vaswani et al.",
          "year": 2017,
          "shortDesc": "Transformer横空出世，彻底改变了NLP和整个AI领域"
        }
      ],
      "relatedTerms": [
        "BERT",
        "GPT",
        "LLM",
        "ViT"
      ]
    },
    {
      "term": "BERT",
      "fullName": "来自Transformer的双向编码器表示",
      "category": "预训练模型",
      "difficulty": 3,
      "aliases": [],
      "explanation": "基于Transformer编码器的预训练语言模型。通过「掩码语言模型」（随机遮住一些词让模型猜）和「下一句预测」两个任务进行预训练，学到的表示可以微调到各种NLP任务。",
      "hoshinoNote": "就是Transformer的编码器部分，做了个「完形填空」训练っす。把一句话遮掉几个词让你猜，猜着猜着就懂语言了。",
      "prerequisiteTerms": [
        "Transformer",
        "预训练",
        "微调"
      ],
      "landmarkPapers": [
        {
          "title": "BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding",
          "authors": "Devlin et al.",
          "year": 2018,
          "shortDesc": "BERT刷爆11个NLP任务的里程碑工作"
        }
      ],
      "relatedTerms": [
        "GPT",
        "掩码语言模型",
        "预训练",
        "微调"
      ]
    },
    {
      "term": "GPT",
      "fullName": "生成式预训练Transformer",
      "category": "预训练模型",
      "difficulty": 3,
      "aliases": [
        "生成式预训练"
      ],
      "explanation": "基于Transformer解码器的自回归语言模型。核心思想：用大量文本做「下一个词预测」预训练，然后通过微调/提示应对各种任务。规模扩大后涌现出强大的对话、推理和代码生成能力。",
      "hoshinoNote": "就是ChatGPT底下那个模型っす。它的训练目标很简单——给你前面的词，猜下一个词是什么。猜着猜着，咦，它就会写诗写代码了。这事情大叔想想也觉得神奇。",
      "prerequisiteTerms": [
        "Transformer",
        "自回归",
        "预训练"
      ],
      "landmarkPapers": [
        {
          "title": "Improving Language Understanding by Generative Pre-Training (GPT-1)",
          "authors": "Radford et al.",
          "year": 2018,
          "shortDesc": "GPT系列的起点"
        },
        {
          "title": "Language Models are Few-Shot Learners (GPT-3)",
          "authors": "Brown et al.",
          "year": 2020,
          "shortDesc": "1750亿参数、少样本学习能力的涌现"
        }
      ],
      "relatedTerms": [
        "Transformer",
        "LLM",
        "RLHF",
        "提示工程"
      ]
    },
    {
      "term": "LLM",
      "fullName": "大语言模型",
      "category": "当前热点",
      "difficulty": 2,
      "aliases": [
        "大型语言模型"
      ],
      "explanation": "通常指参数规模在数十亿以上的语言模型。通过海量文本训练，展现出强大的语言理解、生成、推理、编程等能力。代表性模型：GPT-4, Claude, Gemini, DeepSeek, Qwen等。",
      "hoshinoNote": "就是现在到处都在说的「大模型」っす。读了好多好多书和网页，然后什么都能聊几句。不过它本质上还是个「猜词高手」，不是真理解——大叔友情提醒。",
      "prerequisiteTerms": [
        "GPT",
        "Transformer",
        "预训练"
      ],
      "landmarkPapers": [
        {
          "title": "Scaling Laws for Neural Language Models",
          "authors": "Kaplan et al.",
          "year": 2020,
          "shortDesc": "证明了模型规模、数据量和计算量对性能的幂律关系"
        }
      ],
      "relatedTerms": [
        "GPT",
        "RLHF",
        "涌现",
        "思维链"
      ]
    },
    {
      "term": "RLHF",
      "fullName": "基于人类反馈的强化学习",
      "category": "训练范式",
      "difficulty": 4,
      "aliases": [
        "人类反馈强化学习"
      ],
      "explanation": "让语言模型对齐人类偏好的训练方法。三阶段：1）用人类标注的偏好数据训练奖励模型；2）用奖励模型给模型输出打分；3）用强化学习（PPO）根据分数调整模型参数。ChatGPT的核心技术之一。",
      "hoshinoNote": "就是教会模型「什么答案是好的」っす。先让人打分哪些回答好哪些不好，然后模型自己学着往好的方向生成。有点像大叔训练后辈——「这次干得不错，下次继续～」",
      "prerequisiteTerms": [
        "强化学习",
        "PPO",
        "奖励模型"
      ],
      "landmarkPapers": [
        {
          "title": "Training language models to follow instructions with human feedback (InstructGPT)",
          "authors": "Ouyang et al.",
          "year": 2022,
          "shortDesc": "RLHF在ChatGPT之前的原型工作"
        }
      ],
      "relatedTerms": [
        "PPO",
        "奖励模型",
        "对齐",
        "安全性"
      ]
    },
    {
      "term": "Transformer解码器",
      "fullName": "Transformer解码器",
      "category": "基础架构",
      "difficulty": 3,
      "aliases": [
        "因果解码器"
      ],
      "explanation": "Transformer的解码器部分。与编码器的双向注意力不同，解码器使用因果注意力（Causal Attention/Masked Self-Attention），即每个位置只能看到它前面的位置，不能看后面的。GPT系列使用纯解码器架构。",
      "hoshinoNote": "跟编码器的区别就是——它只能看到「已经说了什么」，不能偷看后面还没说的っす。所以适合做生成任务，一个词一个词地往外蹦。",
      "prerequisiteTerms": [
        "Transformer",
        "Self-Attention",
        "因果掩码"
      ],
      "landmarkPapers": [
        {
          "title": "Attention Is All You Need",
          "authors": "Vaswani et al.",
          "year": 2017,
          "shortDesc": "原始Transformer中的解码器设计"
        }
      ],
      "relatedTerms": [
        "Transformer",
        "GPT",
        "自回归",
        "因果注意力"
      ]
    },
    {
      "term": "Self-Supervised Learning",
      "fullName": "自监督学习",
      "category": "训练范式",
      "difficulty": 3,
      "aliases": [
        "自监督"
      ],
      "explanation": "一种不需要人工标注标签的学习范式。设计「 pretext任务 」让模型从数据本身生成监督信号（如遮住词猜词、旋转图片猜角度、对比学习等）。GPT和BERT的成功证明了自监督学习的巨大潜力。",
      "hoshinoNote": "就是让模型自己教自己っす。不用人辛辛苦苦标数据，模型自己设考题自己考——比如遮掉几个字让你猜，猜不对就改。",
      "prerequisiteTerms": [
        "监督学习",
        "无监督学习"
      ],
      "landmarkPapers": [
        {
          "title": "BERT: Pre-training of Deep Bidirectional Transformers",
          "authors": "Devlin et al.",
          "year": 2018,
          "shortDesc": "MLM掩码任务是自监督学习的经典案例"
        }
      ],
      "relatedTerms": [
        "预训练",
        "掩码语言模型",
        "对比学习"
      ]
    },
    {
      "term": "Diffusion Model",
      "fullName": "扩散模型",
      "category": "生成模型",
      "difficulty": 4,
      "aliases": [
        "扩散模型"
      ],
      "explanation": "一种生成模型，包含正向扩散过程和反向去噪过程。正向：逐步向数据添加噪声直到纯噪声。反向：学习从纯噪声逐步去噪还原出原始数据。DALL-E、Stable Diffusion、Sora等图像/视频生成模型的核心。",
      "hoshinoNote": "简单说就是「先糊成一团，再慢慢变清晰」っす。正向过程给图片撒噪声撒到全花掉，反向过程学怎么一点点去噪还原。你现在看到的AI画图全靠它。",
      "prerequisiteTerms": [
        "生成模型",
        "变分推断",
        "VAE"
      ],
      "landmarkPapers": [
        {
          "title": "Denoising Diffusion Probabilistic Models (DDPM)",
          "authors": "Ho et al.",
          "year": 2020,
          "shortDesc": "扩散模型的奠基之作"
        },
        {
          "title": "High-Resolution Image Synthesis with Latent Diffusion Models (Stable Diffusion)",
          "authors": "Rombach et al.",
          "year": 2022,
          "shortDesc": "潜空间扩散模型，大幅降低计算成本"
        }
      ],
      "relatedTerms": [
        "VAE",
        "生成模型",
        "Stable Diffusion",
        "分数匹配"
      ]
    },
    {
      "term": "Embedding",
      "fullName": "嵌入表示",
      "category": "核心概念",
      "difficulty": 1,
      "aliases": [
        "向量化",
        "词嵌入",
        "嵌入",
        "word embedding",
        "vector embedding"
      ],
      "explanation": "将离散对象（词、句子、图像等）映射到连续向量空间的技术。相似的实体在向量空间中距离更近。所有深度学习模型的第一步基本都是在学某种Embedding。",
      "hoshinoNote": "就是把「词」变成「数字列表」っす。比如「苹果」→[0.3, -0.1, 0.8,...]，「香蕉」→[0.4, -0.2, 0.7,...]，两个数字列越像意思越接近。",
      "prerequisiteTerms": [
        "向量",
        "语义相似度"
      ],
      "landmarkPapers": [
        {
          "title": "Efficient Estimation of Word Representations in Vector Space (Word2Vec)",
          "authors": "Mikolov et al.",
          "year": 2013,
          "shortDesc": "Word2Vec: 词嵌入技术的经典工作"
        }
      ],
      "relatedTerms": [
        "Word2Vec",
        "相似度度量",
        "表示学习"
      ]
    },
    {
      "term": "BatchNorm",
      "fullName": "批归一化",
      "category": "训练技巧",
      "difficulty": 2,
      "aliases": [
        "批量归一化"
      ],
      "explanation": "一种让训练更稳定的技术。在每层输出后对当前batch的数据做归一化（减去均值除以方差），再学习缩放和平移参数。能让网络使用更大的学习率、更快收敛。",
      "hoshinoNote": "相当于给每层的数据「标准化」一下っす。就像做菜时每样调料都称好了再放，不会出现某样东西特别多把味道带歪了。",
      "prerequisiteTerms": [
        "深度学习",
        "梯度消失"
      ],
      "landmarkPapers": [
        {
          "title": "Batch Normalization: Accelerating Deep Network Training by Reducing Internal Covariate Shift",
          "authors": "Ioffe & Szegedy",
          "year": 2015,
          "shortDesc": "BatchNorm原始论文"
        }
      ],
      "relatedTerms": [
        "LayerNorm",
        "训练稳定",
        "学习率"
      ]
    },
    {
      "term": "LayerNorm",
      "fullName": "层归一化",
      "category": "训练技巧",
      "difficulty": 2,
      "aliases": [
        "层归一化"
      ],
      "explanation": "与BatchNorm类似但不同：在单个样本的维度上进行归一化，而不是跨batch。Transformer中广泛使用LayerNorm而不是BatchNorm，因为LayerNorm不受batch大小影响且在序列模型中表现更好。",
      "hoshinoNote": "BatchNorm是对「同一批数据」做归一化，LayerNorm是对「同一个样本的所有特征」做归一化っす。Transformer用LayerNorm不用BatchNorm。",
      "prerequisiteTerms": [
        "BatchNorm",
        "Transformer"
      ],
      "landmarkPapers": [
        {
          "title": "Layer Normalization",
          "authors": "Ba et al.",
          "year": 2016,
          "shortDesc": "LayerNorm原始论文"
        }
      ],
      "relatedTerms": [
        "BatchNorm",
        "Transformer",
        "归一化"
      ]
    },
    {
      "term": "Prompt Engineering",
      "fullName": "提示工程",
      "category": "当前热点",
      "difficulty": 1,
      "aliases": [
        "提示设计",
        "Prompt技巧"
      ],
