LLM_PROVIDER=kimi
LLM_API_KEY=
LLM_API_URL=https://api.moonshot.cn/v1/chat/completions
LLM_MODEL=moonshot-v1-128k
LLM_TIMEOUT=60
APP_HOST=127.0.0.1
APP_PORT=8080

# Optional QQ / WeChat bridge configuration. Keep real values only in local .env.
WECHAT_WEBHOOK_URL=
QQ_BOT_WEBHOOK_URL=
MESSAGE_BRIDGE_TOKEN=

# Backward-compatible Kimi variables are still supported:
# KIMI_API_KEY=
# KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
# KIMI_MODEL=moonshot-v1-128k
