LLM_PROVIDER=kimi
LLM_API_KEY=
LLM_API_URL=https://api.moonshot.cn/v1/chat/completions
LLM_MODEL=moonshot-v1-128k
LLM_TIMEOUT=60
APP_HOST=127.0.0.1
APP_PORT=8080

# Qingxiaoda OpenAI-compatible Agent. Generate a separate random secret.
QXD_API_KEY=
PUBLIC_BASE_URL=
QXD_MODEL_ID=ai-from-zero-agent
QXD_ATTACHMENT_ALLOWED_HOSTS=
QXD_MAX_ATTACHMENT_MB=25
QXD_MAX_CONCURRENCY=4
QXD_REQUEST_TIMEOUT=105
QXD_ARTIFACT_TTL=1800
QXD_ALLOW_PRIVATE_DNS_PROXY=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Optional QQ / WeChat bridge configuration. Keep real values only in local .env.
WECHAT_WEBHOOK_URL=
QQ_BOT_WEBHOOK_URL=
MESSAGE_BRIDGE_TOKEN=

# Backward-compatible Kimi variables are still supported:
# KIMI_API_KEY=
# KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
# KIMI_MODEL=moonshot-v1-128k
